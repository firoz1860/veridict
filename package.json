{
  "name": "veridict",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "worker": "tsx server/worker.ts",
    "db:migrate": "tsx server/migrate.ts",
    "db:seed": "tsx server/seed.ts",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "configure:vercel": "node scripts/configure-vercel.mjs",
    "format": "prettier --write \"{server,web,shared,tests}/**/*.{ts,tsx,css}\" \"*.{ts,json,md}\""
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "framer-motion": "^14.0.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "tsx": "^4.20.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "@playwright/test": "1.55.1",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.9",
    "supertest": "^7.1.4",
    "typescript": "^5.9.2",
    "vite": "^6.3.6"
  }
}
