DATABASE_URL=postgresql://veridict:veridict@localhost:5432/veridict
PORT=3001
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
RUN_WORKER=true
AI_MODE=live
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
SEED_PASSWORD=
# Authenticated-encryption secret for Bring-Your-Own-Key credentials.
# Set to the base64 encoding of 32 random bytes, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# The API and the worker MUST use the SAME value, or saved keys cannot decrypt.
AI_ENCRYPTION_KEY=
# Comma-separated approved hostnames for Custom OpenAI-compatible providers.
# Only these HTTPS hosts may be used; everything else (and all private/loopback/
# link-local/metadata addresses) is rejected. Leave empty to disallow custom.
AI_CUSTOM_ALLOWED_HOSTS=
